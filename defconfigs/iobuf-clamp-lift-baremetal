#
# dma_opt clamp-lift A/B on BARE METAL (nvme.lift_dma_opt_clamp=1).
#
# Boots blk-iobuf-pool-v5-premap-iova-clamp-kconfig on a host you already have
# SSH access to; boot it with nvme.lift_dma_opt_clamp=1 on the kernel command
# line and max_hw_sectors becomes the drive's true MDTS instead of the 128 KiB
# dma_opt clamp. The A/B is then selected at runtime with max_sectors_kb -- no
# rebuild between arms:
#
#   make defconfig-iobuf-clamp-lift-baremetal DECLARE_HOSTS=<ip-or-hostname>
#   make -j$(nproc)
#   make linux                                   # clone + build + boot the kernel
#   scripts/workflows/iobuf_bench/run_clamp_ab.sh # A: 128 KiB vs B: MDTS, cmds+IRQs/GiB
#
# The command size the lift buys is the drive's MDTS: 512 KiB on a Micron 7450,
# 2 MiB on a Samsung PM9A3. run_clamp_ab.sh decodes and prints it. For a command
# size no cheap real drive has (8 MiB), use the emulated defconfig
# iobuf-clamp-lift-qemu instead.
#
# The lift only bites on a TRANSLATING IOMMU (iommu.passthrough=0; intel_iommu=on
# or amd_iommu=on if the box does not already bring the IOMMU up translating) --
# on passthrough there is no dma_opt clamp to lift. The lift is a module
# parameter, not a Kconfig: boot with nvme.lift_dma_opt_clamp=1 on the kernel
# command line (read when the controller is probed). CONFIG_BLK_IOBUF_POOL=y is
# still needed in the kernel config if you also want the premap arm.
#
CONFIG_WORKFLOWS=y
CONFIG_WORKFLOW_LINUX_CUSTOM=y

# Bare metal: use the pre-provisioned host, skip all bringup/teardown.
CONFIG_SKIP_BRINGUP=y
CONFIG_KDEVOPS_USE_DECLARED_HOSTS=y

CONFIG_BOOTLINUX=y
CONFIG_BOOTLINUX_CUSTOM=y
CONFIG_BOOTLINUX_TREE_CUSTOM_NAME="blk-iobuf-pool-clamp-kconfig"
CONFIG_BOOTLINUX_TREE_CUSTOM_URL="https://git.kernel.org/pub/scm/linux/kernel/git/mcgrof/linux.git"
CONFIG_BOOTLINUX_TREE_CUSTOM_REF="blk-iobuf-pool-v5-premap-iova-clamp-kconfig"
CONFIG_BOOTLINUX_TREE_NAME="blk-iobuf-pool-clamp-kconfig"
CONFIG_BOOTLINUX_TREE="https://git.kernel.org/pub/scm/linux/kernel/git/mcgrof/linux.git"
CONFIG_BOOTLINUX_TREE_REF="blk-iobuf-pool-v5-premap-iova-clamp-kconfig"

CONFIG_DEVCONFIG_ENABLE_SYSTEMD_JOURNAL_REMOTE=y
